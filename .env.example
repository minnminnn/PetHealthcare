# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL with PostGIS and pg_trgm extensions
DATABASE_URL="postgresql://postgres:password@localhost:5432/pethealthcare?schema=public"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── UploadThing ─────────────────────────────────────────────────────────────
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# ─── AI — Gemini 1.5 Flash ───────────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
GOOGLE_GENERATIVE_AI_MODEL="gemini-3.6-flash"

# ─── Inngest ─────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY="evt_..."
INNGEST_SIGNING_KEY="signkey-..."

# ─── SMS OTP (Twilio) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Recommended for server-side geocoding. If omitted, the public token below is used.
MAPBOX_ACCESS_TOKEN="pk.eyJ1..."
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1..."

# Skip env validation for Docker builds
SKIP_ENV_VALIDATION=false
